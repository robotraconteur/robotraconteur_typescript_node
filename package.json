{
    "name": "robotraconteur-node",
    "version": "0.1.0",
    "description": "Node.js transports and discovery for the robotraconteur TypeScript client",
    "license": "Apache-2.0",
    "author": "Wason Technology, LLC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/robotraconteur/robotraconteur_typescript_node.git"
    },
    "homepage": "https://robotraconteur.github.io/robotraconteur_typescript_node/",
    "bugs": "https://github.com/robotraconteur/robotraconteur_typescript_node/issues",
    "keywords": [
        "robotraconteur",
        "robot raconteur",
        "robotics",
        "automation",
        "tcp",
        "tls",
        "discovery"
    ],
    "type": "module",
    "sideEffects": [
        "**/service/ServiceHost.*"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "link-shared": "node scripts/link-shared.mjs",
        "build": "npm run link-shared && tsc -p tsconfig.json",
        "prepack": "npm run build",
        "build:test": "npm run build && tsc -p tsconfig.test.json && node scripts/bundle-tests.mjs",
        "test:unit": "npm run build:test && node --test \"dist-test/unit/*.test.mjs\"",
        "test:integration": "npm run build:test && node --test --test-concurrency=1 \"dist-test/integration/*.test.mjs\"",
        "test:extra": "npm run build:test && node --test \"dist-test/extra/*.test.mjs\"",
        "test": "npm run build:test && node --test --test-concurrency=1 \"dist-test/unit/*.test.mjs\" \"dist-test/integration/*.test.mjs\"",
        "docs": "npm run build && typedoc"
    },
    "dependencies": {
        "ws": "8.22.2"
    },
    "peerDependencies": {
        "robotraconteur": "^0.1.0"
    },
    "devDependencies": {
        "@types/node": "22.10.2",
        "@types/ws": "8.18.2",
        "esbuild": "0.24.2",
        "typedoc": "0.28.20",
        "typescript": "5.7.2"
    }
}
